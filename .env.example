# Turso (LibSQL) Database Configuration
# Dapatkan kredensial gratis di https://turso.tech
# Jika dibiarkan kosong, server otomatis menggunakan database SQLite lokal (file:bloxboxd.db)
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Roblox OAuth 2.0 Credentials (Creator Dashboard)
ROBLOX_CLIENT_ID=""
ROBLOX_CLIENT_SECRET=""
ROBLOX_REDIRECT_URI=""

# Upstash Redis Distributed Rate Limiting (https://upstash.com)
# Opsional: jika dibiarkan kosong, limiter berjalan no-op (cocok untuk local dev)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
